\name{econcompare}
\alias{econcompare}
\title{econcompare: outcome-aware econometric model exploration}
\description{Explore, estimate and compare cross-sectional, explanatory time-series and static linear panel econometric models while preserving researcher control over specification choices.}
\details{Version 0.14.4 preserves continuous, binary, nominal categorical and ordinal categorical cross-sectional outcome groups and adds explanatory time-series econometrics with explicit temporal-index auditing, distributed lags, dynamic regression, ARDL-style finite lag specifications, single-equation ECM, and multivariate VAR/VECM systems. Panel APIs provide explicit index auditing, pooled OLS, fixed and random effects, first differences, between, Mundlak, conditional logit, Poisson FE and FE-IV, individual-cluster inference and conditional diagnostics. Forecasting-only workflows are intentionally excluded.}
