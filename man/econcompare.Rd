\name{econcompare}
\alias{econcompare}
\title{econcompare: outcome-aware econometric model exploration}
\description{Explore, estimate and compare cross-sectional econometric models grouped by dependent-variable objective.}
\details{Version 0.11.0 preserves continuous, binary, nominal categorical and ordinal categorical cross-sectional outcome groups and adds explanatory time-series econometrics with explicit temporal-index auditing, distributed lags, dynamic regression, ARDL-style finite lag specifications, single-equation ECM, and multivariate VAR/VECM systems. Forecasting-only workflows are intentionally excluded.}
