\name{eco_diagnostic_tests}
\alias{eco_diagnostic_tests}
\title{List cross-section diagnostic tools}
\usage{
eco_diagnostic_tests()
}
\value{
A data.frame describing the operational cross-section diagnostic ids, including granular IV diagnostics, their categories, compatibility, recommended-engine rules and purpose.
}
\description{
Lists the compatibility-aware diagnostic catalogue used by \code{eco_diagnostics()}.
}
